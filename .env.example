# === Database ===
# Locale (default, zero-config): SQLite
DATABASE_URL="file:./dev.db"
# Produzione con Supabase: cambia provider in prisma/schema.prisma a "postgresql" e usa:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# === AI Cold-Pitch Generator (opzionale — senza chiave usa template smart) ===
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Nome/firma da usare nei pitch generati
SENDER_NAME="Mario Rossi — Web Designer"

# === Invio Email via Resend (opzionale) ===
RESEND_API_KEY=""
FROM_EMAIL="Mario Rossi <mario@tuodominio.it>"

# === Google PageSpeed API (opzionale, arricchisce lo scoring) ===
PAGESPEED_API_KEY=""

# === Google Places (consigliato: sito ufficiale verificato da Google) ===
GOOGLE_PLACES_API_KEY=""

